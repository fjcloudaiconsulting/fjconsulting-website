---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/site';

/*
 * Cloudflare Pages serves this for any unmatched path, with a real 404 status.
 * Without it, Pages falls back to index.html and answers 200 for every
 * nonexistent URL, which reads as a soft 404 to search engines.
 *
 * No <Nav> here deliberately: its links are same-page anchors that resolve to
 * nothing from this route. One way home is more use than five dead ones.
 */
---

<Base
  title={`Page not found — ${company.name}`}
  description="That page does not exist."
>
  <main id="main" class="section notfound">
    <div class="shell">
      <p class="mono notfound__code">404</p>
      <h1>That page does not exist.</h1>
      <p class="lede">The link may be out of date, or the address mistyped.</p>
      <a class="btn btn--primary notfound__cta" href="/">Back to the homepage</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .notfound {
    /* Hold the footer down on a page with very little in it. */
    min-height: 60vh;
  }

  .notfound__code {
    color: var(--gold);
  }

  .notfound h1 {
    margin-top: var(--s-4);
    max-width: 16ch;
  }

  .notfound .lede {
    margin-top: var(--s-4);
    max-width: 42ch;
  }

  .notfound__cta {
    margin-top: var(--s-6);
  }
</style>
