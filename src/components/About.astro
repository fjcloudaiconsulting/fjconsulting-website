---
import { about, company } from '../data/site';
---

<section class="section" id="about">
  <div class="shell about">
    <div class="about__head" data-reveal>
      <h2>{about.heading}</h2>
    </div>

    <div class="prose about__body" data-reveal style="--reveal-delay: 80ms">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <p class="about__signoff">
        <a class="link" href={`mailto:${company.email}`}>{company.email}</a>
      </p>
    </div>
  </div>
</section>

<style>
  /* An asymmetric two-column split rather than a centred block: the heading
     holds the left rail and the prose runs at a comfortable measure beside it. */
  .about {
    display: grid;
    gap: var(--s-6);
    align-items: start;
  }

  .about__head h2 {
    max-width: 15ch;
  }

  .about__signoff {
    margin-top: var(--s-6);
    font-size: var(--t-sm);
  }

  @media (min-width: 54rem) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
    }
  }
</style>
