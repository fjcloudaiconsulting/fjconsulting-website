---
import { contact, company } from '../data/site';
---

<section class="section contact-section" id="contact">
  <div class="shell">
    <div class="contact" data-reveal>
      <h2>{contact.heading}</h2>
      <p class="lede">{contact.lede}</p>

      <a class="btn btn--primary contact__cta" href={`mailto:${company.email}`}>
        Email {company.email}
      </a>

      <p class="contact__note mono">
        Based in {company.address.city}, {company.address.country}
      </p>
    </div>
  </div>
</section>

<style>
  .contact-section {
    border-top: 1px solid var(--line);
  }

  /* A single column at a reading measure. The section asks for one action, so
     it is laid out as one column rather than split into a form beside it. */
  .contact {
    max-width: 46rem;
  }

  .contact h2 {
    max-width: 14ch;
  }

  .contact .lede {
    margin-top: var(--s-4);
  }

  .contact__cta {
    margin-top: var(--s-6);
  }

  .contact__note {
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }
</style>
