---
import monogram from '../assets/monogram-mask.png';
import { company } from '../data/site';

interface Props {
  /** Hide the wordmark and show the monogram alone. */
  markOnly?: boolean;
  class?: string;
}

const { markOnly = false, class: className = '' } = Astro.props;
---

<span class:list={['logo', className]}>
  <span
    class="logo__mark"
    style={`--mask-url: url('${monogram.src}')`}
    aria-hidden="true"></span>
  {
    /* The wordmark is real text, so it is already announced. Only the
       mark-only variant needs an accessible name supplied separately, and
       adding one in both cases would read the company name out twice. */
    markOnly ? (
      <span class="visually-hidden">{company.name}</span>
    ) : (
      <span class="logo__word">
        <span class="logo__word-1">FJ Cloud &amp;</span>
        <span class="logo__word-2">AI Consulting</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
  }

  /*
   * The mark is an alpha mask extracted from the source logo (see
   * scripts/build-brand-assets.mjs) rather than a coloured image. Painting it
   * with a token means it tracks the palette and never carries a navy
   * rectangle that fails to match the page behind it.
   */
  .logo__mark {
    display: block;
    width: var(--logo-size, 1.75rem);
    /* Preserve the source aspect ratio (208 x 255). */
    aspect-ratio: 208 / 255;
    height: auto;
    background: linear-gradient(155deg, var(--gold-hi), var(--gold));
    -webkit-mask-image: var(--mask-url);
    mask-image: var(--mask-url);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    flex-shrink: 0;
  }

  /* The company name is set in real type rather than as a second image: it
     stays crisp, is selectable, and needs no extra request. */
  .logo__word {
    display: grid;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.25;
    white-space: nowrap;
  }

  .logo__word-1 {
    color: var(--ink);
  }

  .logo__word-2 {
    color: var(--gold);
  }
</style>
